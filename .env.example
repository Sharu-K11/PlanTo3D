# Optional. Copy to .env to override defaults (read by Compose and by the backend locally).

# true: Scalar docs and OpenAPI schema. false: animated holding page, no schema.
DEV=true

# Host ports for Compose.
# FRONTEND_PORT=8080
# BACKEND_PORT=8000

# Segmentation model (local only; needs backend/requirements-ml.txt).
# SEGMENTATION_ENABLED=true
# SEGMENTATION_MODEL_PATH=sketch_v1/checkpoints/sketch_model_v1.pth
